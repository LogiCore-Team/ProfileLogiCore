@model IReadOnlyList<TeamMember>
@{
    ViewData["Title"] = "أعضاء الفريق";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">أعضاء الفريق</h1>
        <p>إدارة الأعضاء المعروضين في قسم الفريق.</p>
    </div>
    <a class="btn btn-primary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm" asp-action="Create">
        <i class="bi bi-person-plus-fill"></i>
        <span>إضافة عضو فريق</span>
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover admin-table">
            <thead>
                <tr>
                    <th>اسم العضو</th>
                    <th>الدور</th>
                    <th>المهارات</th>
                    <th>ترتيب العرض</th>
                    <th>الحالة</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="py-5 text-center text-muted">
                            <i class="bi bi-people fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span>لا يوجد أعضاء فريق حتى الآن.</span>
                        </td>
                    </tr>
                }
                @foreach (var member in Model)
                {
                    <tr>
                        <td>
                            <strong>@member.NameEn</strong>
                            <small class="d-block text-secondary" dir="rtl">@member.NameAr</small>
                        </td>
                        <td>@member.RoleEn</td>
                        <td>@(member.SkillsCsv ?? "—")</td>
                        <td>@member.DisplayOrder</td>
                        <td>
                            <span class="fw-semibold text-secondary">@member.RoleEn</span>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(member.SkillsCsv))
                            {
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 220px;" title="@member.SkillsCsv">@member.SkillsCsv</small>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border">#@member.DisplayOrder</span>
                        </td>
                        <td>
                            <span class="badge badge-pill @(member.IsActive ? "badge-active" : "badge-hidden")">
                                <i class="bi @(member.IsActive ? "bi-check-circle-fill" : "bi-eye-slash-fill") me-1"></i>
                                @(member.IsActive ? "نشط" : "مخفي")
                            </span>
                        </td>
                        <td>
                            <div class="admin-actions justify-content-end">
                                <a class="btn-icon btn-icon-primary" asp-action="Edit" asp-route-id="@member.Id" title="تعديل عضو الفريق">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="btn-icon btn-icon-secondary" asp-action="Details" asp-route-id="@member.Id" title="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn-icon btn-icon-danger" asp-action="Delete" asp-route-id="@member.Id" title="حذف عضو الفريق">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
