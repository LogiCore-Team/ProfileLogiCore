@model Portflio.Areas.Admin.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل دخول الإدارة";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - إدارة LOGICORE</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script>
        (() => {
            const theme = sessionStorage.getItem("logicore-theme") === "light" ? "light" : "dark";
            document.documentElement.dataset.theme = theme;
            document.documentElement.classList.toggle("light-theme", theme === "light");
            document.documentElement.classList.toggle("dark-theme", theme === "dark");
        })();
    </script>
    <style>
        :root {
            --font-family: Arial, Tahoma, 'Noto Kufi Arabic', 'Segoe UI', sans-serif;
        }
        body {
            font-family: var(--font-family);
            background-color: #0b0f17;
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            position: relative;
            overflow: hidden;
        }
        /* Background Animated Ambient Glow Blobs */
        .ambient-blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.35;
            z-index: 0;
            pointer-events: none;
        }
        .blob-1 {
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, #4f46e5 0%, #6366f1 100%);
            top: -100px;
            left: -100px;
        }
        .blob-2 {
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, #06b6d4 0%, #3b82f6 100%);
            bottom: -80px;
            right: -80px;
        }
        .login-card {
            position: relative;
            z-index: 1;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 20px;
            padding: 2.75rem 2.5rem;
            width: 100%;
            max-width: 440px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 30px rgba(79, 70, 229, 0.15);
        }
        .brand-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 16px;
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            font-size: 1.6rem;
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.35);
            margin-bottom: 1.25rem;
        }
        .brand-title {
            font-weight: 800;
            font-size: 1.65rem;
            color: #ffffff;
            letter-spacing: -0.025em;
            margin-bottom: 0.35rem;
        }
        .brand-sub {
            color: #94a3b8;
            font-size: 0.925rem;
            margin-bottom: 2rem;
        }
        .input-group-custom {
            position: relative;
            margin-bottom: 1.25rem;
        }
        .input-group-custom i {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 1.1rem;
            pointer-events: none;
            transition: color 0.2s ease;
        }
        .form-control-custom {
            width: 100%;
            padding: 0.75rem 2.75rem 0.75rem 1rem;
            font-family: var(--font-family);
            font-size: 0.95rem;
            background-color: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 12px;
            color: #f8fafc;
            transition: all 0.2s ease;
        }
        .form-control-custom:focus {
            outline: none;
            background-color: rgba(30, 41, 59, 0.9);
            border-color: #6366f1;
            box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
            color: #ffffff;
        }
        .form-control-custom:focus + i,
        .input-group-custom:focus-within i {
            color: #818cf8;
        }
        .form-label-custom {
            font-size: 0.85rem;
            font-weight: 600;
            color: #cbd5e1;
            margin-bottom: 0.4rem;
            display: block;
        }
        .btn-signin {
            background: linear-gradient(135deg, #4f46e5 0%, #6366f1 100%);
            color: #ffffff;
            border: none;
            padding: 0.85rem;
            border-radius: 12px;
            font-weight: 700;
            font-size: 1rem;
            width: 100%;
            margin-top: 0.75rem;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.35);
            transition: all 0.2s ease;
        }
        .btn-signin:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(79, 70, 229, 0.45);
            color: #ffffff;
        }
        .form-check-input-custom {
            background-color: rgba(30, 41, 59, 0.8);
            border-color: rgba(255, 255, 255, 0.2);
        }
        .form-check-input-custom:checked {
            background-color: #6366f1;
            border-color: #6366f1;
        }

        /* Light Theme Overrides for Login Page */
        html[data-theme="light"] body {
            background-color: #F5F0E6;
            color: #0F172A;
        }
        html[data-theme="light"] .login-card {
            background: rgba(255, 253, 248, 0.92);
            border-color: rgba(0, 117, 255, 0.2);
            box-shadow: 0 20px 45px rgba(15, 23, 42, 0.1);
        }
        html[data-theme="light"] .brand-title {
            color: #0F172A;
        }
        html[data-theme="light"] .brand-sub {
            color: #64748B;
        }
        html[data-theme="light"] .form-label-custom {
            color: #334155;
        }
        html[data-theme="light"] .form-control-custom {
            background-color: #FFFFFF;
            border-color: rgba(0, 117, 255, 0.2);
            color: #0F172A;
        }
        html[data-theme="light"] .form-control-custom:focus {
            background-color: #FFFFFF;
            border-color: #0075FF;
            color: #0F172A;
        }
    </style>
</head>
<body>
    <div class="ambient-blob blob-1"></div>
    <div class="ambient-blob blob-2"></div>

    <div class="login-card text-center">
        <div class="brand-badge">
            <i class="bi bi-shield-lock-fill"></i>
        </div>
        <h1 class="brand-title">إدارة LOGICORE</h1>
        <p class="brand-sub">أدخل بيانات الحساب للوصول إلى لوحة الإدارة</p>

        <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post" class="text-start">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 bg-danger bg-opacity-10 text-danger p-2 fs-7 rounded-3 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label-custom">اسم المستخدم</label>
                <div class="input-group-custom">
                    <input asp-for="Username" class="form-control-custom" placeholder="مثال: admin" dir="ltr" autofocus />
                    <i class="bi bi-person-fill"></i>
                </div>
                <span asp-validation-for="Username" class="text-danger small ms-1"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label-custom">كلمة المرور</label>
                <div class="input-group-custom">
                    <input asp-for="Password" type="password" class="form-control-custom" placeholder="••••••••" dir="ltr" />
                    <i class="bi bi-key-fill"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small ms-1"></span>
            </div>

            <div class="form-check mb-4 ms-1">
                <input asp-for="RememberMe" class="form-check-input form-check-input-custom" />
                <label asp-for="RememberMe" class="form-check-label text-slate-300 small">تذكرني على هذا الجهاز</label>
            </div>

            <button type="submit" class="btn btn-signin">
                <span>تسجيل الدخول إلى لوحة الإدارة</span>
                <i class="bi bi-arrow-left ms-2"></i>
            </button>
        </form>
    </div>
</body>
</html>
