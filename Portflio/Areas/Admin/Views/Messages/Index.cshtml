@model IEnumerable<Portflio.Data.Entities.ContactMessage>
@{
    ViewData["Title"] = "رسائل التواصل";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">رسائل التواصل</h1>
        <p>مراجعة وإدارة الرسائل الواردة من نموذج التواصل في الموقع.</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="admin-card text-center text-muted py-5">
        <i class="bi bi-envelope-open fs-1 text-secondary opacity-50 d-block mb-2"></i>
        <p class="mb-0 fw-medium">لم تصل أي رسائل حتى الآن.</p>
    </div>
}
else
{
    <div class="admin-card p-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table admin-table">
                <thead>
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>اسم المرسل</th>
                        <th>البريد الإلكتروني</th>
                        <th>الموضوع</th>
                        <th>نص الرسالة</th>
                        <th>الحالة</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? "opacity-75" : "fw-bold bg-primary bg-opacity-10")">
                            <td class="text-nowrap text-muted small">
                                <i class="bi bi-clock me-1"></i>@item.CreatedAt.ToString("g")
                            </td>
                            <td>
                                <span class="fw-semibold">@item.Name</span>
                            </td>
                            <td>
                                <a href="mailto:@item.Email" class="text-primary text-decoration-none d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-envelope"></i>
                                    <span>@item.Email</span>
                                </a>
                            </td>
                            <td>
                                <span class="fw-semibold">@item.Subject</span>
                            </td>
                            <td style="max-width: 280px;" class="position-relative">
                                <div class="message-preview-wrapper">
                                    <span class="text-truncate d-inline-block mw-100 align-middle text-muted">@item.Message</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-1.5 ms-1 rounded-2 shadow-sm message-expand-btn" data-bs-toggle="modal" data-bs-target="#messageModal-@item.Id" title="عرض الرسالة كاملة">
                                        <i class="bi bi-eye-fill"></i>
                                    </button>
                                    
                                    <!-- Hover Popover Floating Card -->
                                    <div class="message-hover-popover">
                                        <div class="popover-header-custom">
                                            <i class="bi bi-chat-left-text-fill text-primary me-1"></i>
                                            <span>نص الرسالة كاملًا</span>
                                        </div>
                                        <div class="popover-body-custom">@item.Message</div>
                                    </div>
                                </div>

                                <!-- Full View Modal -->
                                <div class="modal fade" id="messageModal-@item.Id" tabindex="-1" aria-labelledby="messageModalLabel-@item.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg">
                                        <div class="modal-content border-0 shadow-lg rounded-4">
                                            <div class="modal-header border-bottom">
                                                <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="messageModalLabel-@item.Id">
                                                    <i class="bi bi-envelope-open-fill text-primary"></i>
                                                    <span>رسالة من: @item.Name</span>
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                                            </div>
                                            <div class="modal-body p-4 text-start">
                                                <div class="row g-3 mb-4 pb-3 border-bottom text-muted small">
                                                    <div class="col-sm-6">
                                                        <i class="bi bi-person-fill text-primary ms-1"></i><strong>المرسل:</strong> @item.Name
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <i class="bi bi-envelope-fill text-primary ms-1"></i><strong>البريد:</strong> <a href="mailto:@item.Email" class="text-primary text-decoration-none">@item.Email</a>
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <i class="bi bi-tag-fill text-primary ms-1"></i><strong>الموضوع:</strong> @item.Subject
                                                    </div>
                                                    <div class="col-sm-6">
                                                        <i class="bi bi-clock-fill text-primary ms-1"></i><strong>التاريخ:</strong> @item.CreatedAt.ToString("g")
                                                    </div>
                                                </div>
                                                <div class="message-modal-body p-3.5 rounded-3 border">
                                                    <p class="mb-0 lh-lg text-break whitespace-pre-line fs-6">@item.Message</p>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-top">
                                                @if (!item.IsRead)
                                                {
                                                    <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="d-inline">
                                                        <button type="submit" class="btn btn-success px-4 rounded-3 d-inline-flex align-items-center gap-2">
                                                            <i class="bi bi-check2-circle"></i>
                                                            <span>تحديد كمقروءة</span>
                                                        </button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">إغلاق</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge badge-hidden">
                                        <i class="bi bi-envelope-open me-1"></i>مقروءة
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-active">
                                        <i class="bi bi-envelope-fill me-1"></i>جديدة
                                    </span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <div class="admin-actions justify-content-end">
                                    @if (!item.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn-icon btn-icon-success" title="تحديد كمقروءة">
                                                <i class="bi bi-check2-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من حذف هذه الرسالة؟');">
                                        <button type="submit" class="btn-icon btn-icon-danger" title="حذف الرسالة">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
