@model IReadOnlyList<Service>
@{
    ViewData["Title"] = "الخدمات";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">الخدمات</h1>
        <p>إدارة الخدمات المعروضة في الصفحة الرئيسية.</p>
    </div>
    <a class="btn btn-primary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg"></i>
        <span>إضافة خدمة</span>
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover admin-table">
            <thead>
                <tr>
                    <th>عنوان الخدمة</th>
                    <th>فئة الأيقونة</th>
                    <th>ترتيب العرض</th>
                    <th>الحالة</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span>لا توجد خدمات حتى الآن.</span>
                        </td>
                    </tr>
                }
                @foreach (var service in Model)
                {
                    <tr>
                        <td>
                            <strong>@service.TitleEn</strong>
                            <small class="d-block text-secondary" dir="rtl">@service.TitleAr</small>
                        </td>
                        <td>@(service.IconClass ?? "—")</td>
                        <td>@service.DisplayOrder</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(service.IconClass))
                            {
                                <code class="bg-light px-2 py-1 rounded text-primary fs-7"><i class="@service.IconClass me-1"></i>@service.IconClass</code>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border">#@service.DisplayOrder</span>
                        </td>
                        <td>
                            <span class="badge badge-pill @(service.IsActive ? "badge-active" : "badge-hidden")">
                                <i class="bi @(service.IsActive ? "bi-check-circle-fill" : "bi-eye-slash-fill") me-1"></i>
                                @(service.IsActive ? "نشطة" : "مخفية")
                            </span>
                        </td>
                        <td>
                            <div class="admin-actions justify-content-end">
                                <a class="btn-icon btn-icon-primary" asp-action="Edit" asp-route-id="@service.Id" title="تعديل الخدمة">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="btn-icon btn-icon-secondary" asp-action="Details" asp-route-id="@service.Id" title="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn-icon btn-icon-danger" asp-action="Delete" asp-route-id="@service.Id" title="حذف الخدمة">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
