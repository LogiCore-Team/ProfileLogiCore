@model Service
@{
    ViewData["Title"] = "تفاصيل الخدمة";
}

<div class="admin-page-heading">
    <div><h1 class="h3 mb-0">@Model.TitleEn</h1><p dir="rtl">@Model.TitleAr</p></div>
    <div class="admin-actions">
        <a class="btn btn-primary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm" asp-action="Edit" asp-route-id="@Model.Id">
            <i class="bi bi-pencil-square"></i><span>تعديل الخدمة</span>
        </a>
        <a class="btn btn-outline-secondary rounded-3 px-3 py-2" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>رجوع
        </a>
    </div>
</div>

<div class="detail-card">
    <div class="admin-card-header">
        <h2 class="h6 mb-0 text-uppercase tracking-wider text-muted fw-bold">بيانات الخدمة</h2>
    </div>
    <dl class="detail-list">
        <dt>الوصف بالإنجليزية (EN)</dt><dd class="text-dark" dir="ltr">@Model.DescriptionEn</dd>
        <dt>الوصف بالعربية (AR)</dt><dd class="text-dark">@Model.DescriptionAr</dd>
        <dt>فئة الأيقونة</dt>
        <dd>
            @if (!string.IsNullOrWhiteSpace(Model.IconClass))
            {
                <code class="bg-light px-2 py-1 rounded text-primary"><i class="@Model.IconClass me-1"></i>@Model.IconClass</code>
            }
            else
            {
                <span class="text-muted">—</span>
            }
        </dd>
        <dt>ترتيب العرض</dt><dd><span class="badge bg-light text-dark border">#@Model.DisplayOrder</span></dd>
        <dt>الحالة</dt>
        <dd>
            <span class="badge badge-pill @(Model.IsActive ? "badge-active" : "badge-hidden")">
                <i class="bi @(Model.IsActive ? "bi-check-circle-fill" : "bi-eye-slash-fill") me-1"></i>
                @(Model.IsActive ? "نشطة" : "مخفية")
            </span>
        </dd>
    </dl>
</div>
