@model ProjectFormViewModel
@{
    ViewData["Title"] = "تعديل المشروع";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">تعديل المشروع</h1>
        <p>حدّث محتوى المشروع والسجلات المرتبطة به.</p>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="admin-card">
    <input asp-for="Id" type="hidden" />
    <partial name="_ProjectForm" model="Model" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
