@model IReadOnlyList<Technology>
@{
    ViewData["Title"] = "التقنيات";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">التقنيات</h1>
        <p>إدارة التقنيات القابلة للربط بالمشاريع.</p>
    </div>
    <a class="btn btn-primary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg"></i>
        <span>إضافة تقنية</span>
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover admin-table">
            <thead>
                <tr>
                    <th>اسم التقنية</th>
                    <th>فئة الأيقونة</th>
                    <th>الأيقونة</th>
                    <th>المشاريع المرتبطة</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span>لا توجد تقنيات حتى الآن.</span>
                        </td>
                    </tr>
                }
                @foreach (var technology in Model)
                {
                    <tr>
                        <td>
                            <strong class="text-dark fw-bold">@technology.Name</strong>
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(technology.IconClass))
                            {
                                <code class="bg-light px-2 py-1 rounded text-primary fs-7"><i class="@technology.IconClass me-1"></i>@technology.IconClass</code>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(technology.IconSvg))
                            {
                                <div class="d-inline-flex align-items-center gap-2">
                                    <div style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; color: #38bdf8;">
                                        @Html.Raw(technology.IconSvg)
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary">SVG</span>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(technology.ImageUrl))
                            {
                                <span class="badge badge-active">
                                    <i class="bi bi-image me-1"></i>صورة
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-hidden">بلا أيقونة</span>
                            }
                        </td>
                        <td>
                            <span class="badge badge-tech">@technology.ProjectTechnologies.Count مشروع</span>
                        </td>
                        <td>
                            <div class="admin-actions justify-content-end">
                                <a class="btn-icon btn-icon-primary" asp-action="Edit" asp-route-id="@technology.Id" title="تعديل التقنية">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="btn-icon btn-icon-secondary" asp-action="Details" asp-route-id="@technology.Id" title="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn-icon btn-icon-danger" asp-action="Delete" asp-route-id="@technology.Id" title="حذف التقنية">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
