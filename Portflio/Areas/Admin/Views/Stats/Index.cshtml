@model IReadOnlyList<StatItem>
@{
    ViewData["Title"] = "الإحصائيات";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">الإحصائيات</h1>
        <p>إدارة مؤشرات الأداء المعروضة في الصفحة الرئيسية.</p>
    </div>
    <a class="btn btn-primary rounded-3 px-3 py-2 d-inline-flex align-items-center gap-2 shadow-sm" asp-action="Create">
        <i class="bi bi-plus-lg"></i>
        <span>إضافة إحصائية</span>
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>قيمة المؤشر</th>
                    <th>العنوان بالعربية (AR)</th>
                    <th>العنوان بالإنجليزية (EN)</th>
                    <th>ترتيب العرض</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="py-5 text-center text-muted">
                            <i class="bi bi-bar-chart-line fs-2 d-block mb-2 text-secondary opacity-50"></i>
                            <span>لا توجد إحصائيات حتى الآن.</span>
                        </td>
                    </tr>
                }
                @foreach (var stat in Model)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary-subtle text-primary fw-bold fs-6 px-3 py-1 rounded-pill">
                                @stat.Value
                            </span>
                        </td>
                        <td dir="rtl">
                            <strong class="text-dark">@stat.LabelAr</strong>
                        </td>
                        <td>
                            <span class="text-muted">@stat.LabelEn</span>
                        </td>
                        <td>
                            <span class="badge bg-light text-secondary border">#@stat.DisplayOrder</span>
                        </td>
                        <td>
                            <div class="admin-actions justify-content-end">
                                <a class="btn-icon btn-icon-primary" asp-action="Edit" asp-route-id="@stat.Id" title="تعديل الإحصائية">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="btn-icon btn-icon-secondary" asp-action="Details" asp-route-id="@stat.Id" title="عرض التفاصيل">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a class="btn-icon btn-icon-danger" asp-action="Delete" asp-route-id="@stat.Id" title="حذف الإحصائية">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
