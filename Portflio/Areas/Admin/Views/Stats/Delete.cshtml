@model StatItem
@{
    ViewData["Title"] = "حذف الإحصائية";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">حذف الإحصائية</h1>
        <p>أكد إزالة هذا المؤشر الإحصائي.</p>
    </div>
</div>
<div class="admin-card">
    <div class="alert alert-danger border-0 shadow-sm mb-4">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>هذا الإجراء لا يمكن التراجع عنه.</strong> ستُحذف الإحصائية من الموقع.
    </div>
    <dl class="row mb-4">
        <dt class="col-sm-3 text-muted">قيمة المؤشر</dt>
        <dd class="col-sm-9 fw-bold">@Model.Value</dd>

        <dt class="col-sm-3 text-muted">العنوان بالعربية (AR)</dt>
        <dd class="col-sm-9" dir="rtl">@Model.LabelAr</dd>

        <dt class="col-sm-3 text-muted">العنوان بالإنجليزية (EN)</dt>
        <dd class="col-sm-9">@Model.LabelEn</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm" type="submit">
            <i class="bi bi-trash3 me-1"></i>حذف نهائي
        </button>
        <a class="btn btn-outline-secondary px-4 py-2 rounded-3" asp-action="Index">إلغاء</a>
    </form>
</div>
