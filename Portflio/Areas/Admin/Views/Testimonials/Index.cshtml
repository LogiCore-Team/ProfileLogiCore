@model IReadOnlyList<Testimonial>
@{
    ViewData["Title"] = "شهادات العملاء";
}

<div class="admin-page-heading">
    <div>
        <h1 class="h3 mb-0">شهادات العملاء</h1>
        <p>إدارة آراء العملاء المعروضة في الصفحة الرئيسية.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">
        <i class="bi bi-plus-lg"></i>
        إضافة شهادة
    </a>
</div>

<div class="admin-card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table admin-table">
            <thead>
                <tr>
                    <th>اسم العميل</th>
                    <th>الشركة</th>
                    <th>التقييم</th>
                    <th>الترتيب</th>
                    <th>الحالة</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="py-5 text-center text-secondary">لا توجد شهادات عملاء حتى الآن.</td>
                    </tr>
                }
                @foreach (var testimonial in Model)
                {
                    <tr>
                        <td>
                            <strong>@testimonial.NameAr</strong>
                            <small class="d-block text-secondary" dir="ltr">@testimonial.NameEn</small>
                        </td>
                        <td>@testimonial.CompanyAr</td>
                        <td><span class="text-warning">@(new string('★', testimonial.Rating))</span></td>
                        <td>@testimonial.DisplayOrder</td>
                        <td>
                            <span class="badge @(testimonial.IsActive ? "badge-active" : "badge-hidden")">
                                @(testimonial.IsActive ? "نشطة" : "مخفية")
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="admin-actions justify-content-end">
                                <a class="btn-icon btn-icon-primary" asp-action="Edit" asp-route-id="@testimonial.Id" title="تعديل">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a class="btn-icon btn-icon-danger" asp-action="Delete" asp-route-id="@testimonial.Id" title="حذف">
                                    <i class="bi bi-trash3"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
