@model Testimonial

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="admin-form-section">
    <div class="admin-form-section-title">
        <i class="bi bi-person-fill"></i>
        <span>بيانات العميل</span>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="NameAr" class="form-label">اسم العميل بالعربية (AR)</label>
            <input asp-for="NameAr" class="form-control" dir="rtl" />
            <span asp-validation-for="NameAr" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="NameEn" class="form-label">اسم العميل بالإنجليزية (EN)</label>
            <input asp-for="NameEn" class="form-control" dir="ltr" />
            <span asp-validation-for="NameEn" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyAr" class="form-label">اسم الشركة بالعربية (AR)</label>
            <input asp-for="CompanyAr" class="form-control" dir="rtl" />
            <span asp-validation-for="CompanyAr" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="CompanyEn" class="form-label">اسم الشركة بالإنجليزية (EN)</label>
            <input asp-for="CompanyEn" class="form-control" dir="ltr" />
            <span asp-validation-for="CompanyEn" class="text-danger"></span>
        </div>
    </div>
</div>

<div class="admin-form-section">
    <div class="admin-form-section-title">
        <i class="bi bi-chat-quote-fill"></i>
        <span>نص الشهادة</span>
    </div>
    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="QuoteAr" class="form-label">الشهادة بالعربية (AR)</label>
            <textarea asp-for="QuoteAr" class="form-control" rows="6" dir="rtl"></textarea>
            <span asp-validation-for="QuoteAr" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="QuoteEn" class="form-label">الشهادة بالإنجليزية (EN)</label>
            <textarea asp-for="QuoteEn" class="form-control" rows="6" dir="ltr"></textarea>
            <span asp-validation-for="QuoteEn" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Rating" class="form-label">التقييم من 5</label>
            <input asp-for="Rating" class="form-control" min="1" max="5" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="DisplayOrder" class="form-label">ترتيب العرض</label>
            <input asp-for="DisplayOrder" class="form-control" min="0" />
            <span asp-validation-for="DisplayOrder" class="text-danger"></span>
        </div>
        <div class="col-md-4 d-flex align-items-end pb-2">
            <div class="form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">نشطة ومعروضة في الموقع</label>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2">
    <button class="btn btn-primary" type="submit">
        <i class="bi bi-check-lg"></i>
        حفظ الشهادة
    </button>
    <a class="btn btn-outline-secondary" asp-action="Index">إلغاء</a>
</div>
