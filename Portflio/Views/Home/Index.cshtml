@model HomePageViewModel
@{
    ViewData["Title"] = "Smart Software Engineering Team";
    ViewData["Description"] = "LOGICORE engineers intelligent web, mobile, AI, and enterprise software products.";
    ViewData["Page"] = "home";
}

<main id="main" class="home-page">
    <section class="hero section brand-hero" id="home" aria-labelledby="hero-title">
        <div class="hero-bg" aria-hidden="true">
            <div class="hero-grid-pattern"></div>
            <span class="node node-a"></span>
            <span class="node node-b"></span>
            <span class="node node-c"></span>
            <span class="node node-d"></span>
            <span class="circuit-line line-a"></span>
            <span class="circuit-line line-b"></span>
            <span class="circuit-line line-c"></span>
        </div>
        <div class="hero-grid shell">
            <div class="hero-copy reveal">
                <div class="hero-brand-pill" aria-label="LOGICORE">
                    <span class="gold-spark" aria-hidden="true">✦</span>
                    <strong>LOGICORE</strong>
                </div>
                <p class="eyebrow" data-i18n="heroEyebrow">Software Engineering Team</p>
                <h1 id="hero-title" class="gradient-heading" data-i18n-html="heroTitle">
                    برمجيات ذكية <span class="text-gradient-electric">مصممة بإتقان</span> هندسي<span class="gold-dot-accent">.</span>
                </h1>
                <p class="hero-lead" data-i18n="heroLead">
                    تصميم أنظمة ذكية ومنتجات ويب حديثة وتجارب جوال ومنصات مؤسسية قابلة للتوسع بثبات.
                </p>
                <p class="typing-line" aria-live="polite">
                    <span data-i18n="typingPrefix">We build</span>
                    <span class="typing-text" data-typing></span>
                    <span class="typing-cursor" aria-hidden="true"></span>
                </p>
                <div class="hero-actions">
                    <a class="btn primary btn-hero-primary" asp-controller="Projects" asp-action="Index">
                        <span data-i18n="heroCtaWork">استكشف أعمالنا</span>
                        <svg class="btn-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    <a class="btn ghost btn-hero-ghost" asp-controller="Home" asp-action="Index" asp-fragment="contact" data-i18n="heroCtaContact">تواصل معنا</a>
                </div>

                <div class="hero-features-grid">
                    <div class="hero-feature-item">
                        <div class="feature-icon-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"/>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"/>
                                <rect x="14" y="14" width="7" height="7" rx="1.5"/>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"/>
                            </svg>
                        </div>
                        <span data-i18n="heroFeature1">حلول مخصصة</span>
                    </div>
                    <div class="hero-feature-item">
                        <div class="feature-icon-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                <path d="M7 11V7a5 5 0 0110 0v4"/>
                            </svg>
                        </div>
                        <span data-i18n="heroFeature2">أمان متكامل</span>
                    </div>
                    <div class="hero-feature-item">
                        <div class="feature-icon-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                            </svg>
                        </div>
                        <span data-i18n="heroFeature3">أداء عالي</span>
                    </div>
                    <div class="hero-feature-item">
                        <div class="feature-icon-box">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                                <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                <line x1="12" y1="22.08" x2="12" y2="12"/>
                            </svg>
                        </div>
                        <span data-i18n="heroFeature4">قابلية للتوسع</span>
                    </div>
                </div>
            </div>

            <div class="hero-visual reveal" aria-label="LOGICORE 3D Engineering Platform Interface" data-i18n-aria="heroVisualLabel">
                <!-- Background Orbit & Aura Glow -->
                <div class="visual-glow-aura" aria-hidden="true"></div>
                <div class="visual-orbits" aria-hidden="true">
                    <div class="orbit-ring ring-outer"></div>
                    <div class="orbit-ring ring-inner"></div>
                    <span class="tech-particle p1"></span>
                    <span class="tech-particle p2"></span>
                    <span class="tech-particle p3"></span>
                    <span class="tech-particle p4"></span>
                </div>

                <!-- 3D Device & Pedestal Scene -->
                <div class="device-3d-scene">
                    <div class="pedestal-base" aria-hidden="true">
                        <div class="pedestal-glow"></div>
                        <div class="pedestal-gold-rim"></div>
                    </div>

                    <div class="device-3d-card">
                        <div class="device-header">
                            <div class="window-controls">
                                <span class="control dot-red"></span>
                                <span class="control dot-yellow"></span>
                                <span class="control dot-green"></span>
                            </div>
                            <div class="device-brand-tag">
                                <span class="gold-spark-sm">✦</span>
                                <strong>LOGICORE CORE</strong>
                                <span class="status-pulse"></span>
                            </div>
                        </div>
                        
                        <div class="device-body device-logo-only-body">
                            <div class="device-logo-hero-showcase">
                                <div class="logo-glow-backdrop"></div>
                                <img src="~/Logo/اطار_-removebg-preview.png" alt="LOGICORE Logo" class="device-3d-logo-large" />

                            </div>
                        </div>

                        <div class="device-gold-reflection" aria-hidden="true"></div>
                    </div>
                </div>

                <!-- Floating Glassmorphism Cards -->
                <div class="floating-glass-card glass-card-a">
                    <div class="glass-icon-wrapper">
                        <svg class="glass-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                            <path d="M9 12l2 2 4-4" stroke="#D4AF37" stroke-width="2.5" stroke-linecap="round"/>
                        </svg>
                    </div>
                    <div class="glass-card-content">
                        <strong class="glass-number">99.9%</strong>
                        <span class="glass-label" data-i18n="heroSignalA">تسليم موثوق</span>
                    </div>
                </div>

                <div class="floating-glass-card glass-card-b">
                    <div class="glass-icon-wrapper">
                        <svg class="glass-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" stroke="#0075FF"/>
                            <circle cx="17" cy="6" r="1.5" fill="#D4AF37"/>
                        </svg>
                        <span class="gold-accent-dot"></span>
                    </div>
                    <div class="glass-card-content">
                        <strong class="glass-number">&lt;120ms</strong>
                        <span class="glass-label" data-i18n="heroSignalB">واجهات سريعة</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-title">
        <div class="shell split">
            <div class="section-copy reveal">
                <p class="eyebrow" data-i18n="aboutEyebrow">About LOGICORE</p>
                <h2 id="about-title" data-i18n="aboutTitle">We turn complex business logic into elegant digital products.</h2>
                <p data-i18n="aboutText">Our team blends architecture, product thinking, clean interfaces, and reliable engineering to ship systems that teams trust every day.</p>
            </div>
            <div class="values-grid reveal">
                <article>
                    <h3 data-i18n="visionTitle">Vision</h3>
                    <p data-i18n="visionText">Make intelligent software practical, maintainable, and valuable for ambitious teams.</p>
                </article>
                <article>
                    <h3 data-i18n="missionTitle">Mission</h3>
                    <p data-i18n="missionText">Deliver polished applications backed by strong architecture and measurable quality.</p>
                </article>
                <article>
                    <h3 data-i18n="craftTitle">Craft</h3>
                    <p data-i18n="craftText">Write readable code, design humane workflows, and document decisions that matter.</p>
                </article>
            </div>
        </div>
        <div class="stats shell reveal bento-grid bento-stats">
            @foreach (var stat in Model.Stats)
            {
                <article>
                    <strong>@stat.Value</strong>
                    <span data-localized data-en="@stat.Label.English" data-ar="@stat.Label.Arabic">@stat.Label.English</span>
                </article>
            }
        </div>
    </section>

    <section class="section" id="services" aria-labelledby="services-title">
        <div class="shell section-head reveal">
            <p class="eyebrow" data-i18n="servicesEyebrow">Services</p>
            <h2 id="services-title" data-i18n="servicesTitle">Engineering services for modern digital teams.</h2>
            <p data-i18n="servicesIntro">From product interfaces to cloud-backed enterprise systems, LOGICORE builds the pieces that keep organizations moving.</p>
        </div>
        <div class="shell card-grid services-grid bento-grid bento-services" data-services>
            @foreach (var service in Model.Services)
            {
                <article class="service-card reveal bento-card">
                    <span class="service-icon">@service.Icon</span>
                    <h3 data-localized data-en="@service.Title.English" data-ar="@service.Title.Arabic">@service.Title.English</h3>
                    <p data-localized data-en="@service.Description.English" data-ar="@service.Description.Arabic">@service.Description.English</p>
                </article>
            }
        </div>
    </section>

    <section class="section tech-section" id="tech" aria-labelledby="tech-title">
        <div class="shell section-head reveal">
            <p class="eyebrow" data-i18n="techEyebrow">Technology Stack</p>
            <h2 id="tech-title" data-i18n="techTitle">A sharp stack for reliable products.</h2>
            <p data-i18n="techIntro">Filter the tools our team uses across backend, frontend, intelligent systems, and cloud delivery.</p>
        </div>
        <div class="shell filter-bar reveal" data-filter-controls="tech" aria-label="Technology filters">
            <button type="button" class="active" data-filter="all" aria-pressed="true" data-i18n="all">All</button>
            @foreach (var category in Model.TechnologyCategories.Where(c => c.Key != "all"))
            {
                <button type="button"
                        data-filter="@category.Key"
                        aria-pressed="false"
                        data-localized
                        data-en="@category.Label.English"
                        data-ar="@category.Label.Arabic">
                    @category.Label.English
                </button>
            }
        </div>
        <div class="shell tech-grid" data-tech-grid data-filter-grid="tech">
            @foreach (var technology in Model.Technologies)
            {
                <article class="tech-card reveal" data-filter-item data-category="@technology.CategoryKey">
                    @if (!string.IsNullOrWhiteSpace(technology.IconSvg))
                    {
                        <div class="tech-card-icon">
                            @Html.Raw(technology.IconSvg)
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(technology.ImageUrl))
                    {
                        <img src="@technology.ImageUrl" alt="@technology.Name" style="width: 2.5rem; height: 2.5rem; object-fit: contain;" />
                    }
                    else if (!string.IsNullOrWhiteSpace(technology.IconClass))
                    {
                        <i class="@technology.IconClass fs-3 text-primary"></i>
                    }
                    <strong>@technology.Name</strong>
                    <span data-localized data-en="@technology.Note.English" data-ar="@technology.Note.Arabic">@technology.Note.English</span>
                </article>
            }
        </div>
    </section>

    <section class="section" id="portfolio" aria-labelledby="portfolio-title">
        <div class="shell section-head section-head-with-action reveal">
            <div>
                <p class="eyebrow" data-i18n="portfolioEyebrow">Portfolio</p>
                <h2 id="portfolio-title" data-i18n="portfolioTitle">Selected work shaped for speed, clarity, and scale.</h2>
                <p data-i18n="portfolioIntro">Explore LOGICORE project work across web, mobile, smart systems, and enterprise platforms.</p>
            </div>
            <a class="text-link" asp-controller="Projects" asp-action="Index" data-i18n="allProjects">View all projects</a>
        </div>
        <div class="shell filter-bar reveal" data-filter-controls="home-projects" aria-label="Project filters">
            <button type="button" class="active" data-filter="all" aria-pressed="true" data-i18n="all">All</button>
            @foreach (var category in Model.ProjectCategories)
            {
                <button type="button"
                        data-filter="@category.Key"
                        aria-pressed="false"
                        data-localized
                        data-en="@category.Label.English"
                        data-ar="@category.Label.Arabic">@category.Label.English</button>
            }
        </div>
        <div class="shell card-grid portfolio-grid bento-grid bento-projects" data-projects data-filter-grid="home-projects">
            @foreach (var project in Model.FeaturedProjects)
            {
                <partial name="_ProjectCard" model="project" />
            }
        </div>
        <p class="shell filter-empty" data-filter-empty="home-projects" hidden data-i18n="noProjects">No projects match this filter.</p>
    </section>

    <section class="section team-section" id="team" aria-labelledby="team-title">
        <div class="shell section-head reveal">
            <p class="eyebrow" data-i18n="teamEyebrow">Team</p>
            <h2 id="team-title" data-i18n="teamTitle">Senior builders with product instincts.</h2>
            <p data-i18n="teamIntro">A compact team covering architecture, experience design, backend systems, mobile delivery, and intelligent automation.</p>
        </div>
        <div class="shell card-grid team-grid" data-team>
            @foreach (var member in Model.TeamMembers)
            {
                <article class="team-card reveal">
                    <span class="member-avatar">@member.Initials</span>
                    <h3 data-localized data-en="@member.Name.English" data-ar="@member.Name.Arabic">@member.Name.English</h3>
                    <p data-localized data-en="@member.Role.English" data-ar="@member.Role.Arabic">@member.Role.English</p>
                    <div class="badge-row">
                        @foreach (var skill in member.Skills)
                        {
                            <span class="badge">@skill</span>
                        }
                    </div>
                    <div class="member-links">
                        <a href="@member.GitHubUrl" target="_blank" rel="noreferrer">GitHub</a>
                        <a href="@member.LinkedInUrl" target="_blank" rel="noreferrer">LinkedIn</a>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="section testimonials-section" id="testimonials" aria-labelledby="testimonials-title">
        <div class="shell section-head reveal">
            <p class="eyebrow" data-i18n="testimonialsEyebrow">Client Success</p>
            <h2 id="testimonials-title" data-i18n="testimonialsTitle">Teams choose LOGICORE when software has to work beautifully.</h2>
        </div>

        @if (Model.Testimonials.Count > 0)
        {
            <div class="shell testimonials-grid reveal">
                @foreach (var testimonial in Model.Testimonials)
                {
                    var nameEn = testimonial.Name.English;
                    var nameParts = nameEn.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                    var initials = nameParts.Length > 0
                        ? string.Concat(nameParts.Take(2).Select(p => char.ToUpperInvariant(p[0])))
                        : "LC";

                    <article class="testimonial-card">
                        <div class="card-top">
                            <div class="rating" aria-label="@testimonial.Rating out of 5 stars">
                                @(new string('★', testimonial.Rating))
                            </div>
                            <span class="testimonial-avatar">@initials</span>
                        </div>
                        <p class="quote-text">
                            “<span class="loc-en">@testimonial.Quote.English</span><span class="loc-ar">@testimonial.Quote.Arabic</span>”
                        </p>
                        <div class="testimonial-meta">
                            <strong class="client-name">
                                <span class="loc-en">@testimonial.Name.English</span>
                                <span class="loc-ar">@testimonial.Name.Arabic</span>
                            </strong>
                            <span class="client-company">
                                <span class="loc-en">@testimonial.Company.English</span>
                                <span class="loc-ar">@testimonial.Company.Arabic</span>
                            </span>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="shell testimonials-empty-state reveal">
                <div class="empty-icon-box">
                    <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
                <h3 data-i18n="noTestimonialsTitle">لا تتوفر شهادات حالياً</h3>
                <p data-i18n="noTestimonials">ستظهر شهادات وآراء العملاء هنا فور إضافتها من لوحة الإدارة.</p>
            </div>
        }
    </section>

    <section class="section contact-section" id="contact" aria-labelledby="contact-title">
        <div class="shell contact-grid">
            <div class="section-copy reveal">
                <p class="eyebrow" data-i18n="contactEyebrow">Contact</p>
                <h2 id="contact-title" data-i18n="contactTitle">Tell us what you want to build.</h2>
                <p data-i18n="contactIntro">Share your idea, platform, or business workflow. LOGICORE will help shape the path from concept to production.</p>
                <div class="contact-cards">
                    <article><span>@@</span><div><h3 data-i18n="contactEmailTitle">Email</h3><p>hello@logicore.dev</p></div></article>
                    <article><span>⌖</span><div><h3 data-i18n="contactLocationTitle">Location</h3><p data-i18n="contactLocation">Remote-first, serving global teams</p></div></article>
                    <article><span>⏱</span><div><h3 data-i18n="contactResponseTitle">Response Time</h3><p data-i18n="contactResponse">Usually within one business day</p></div></article>
                </div>
            </div>

            <form class="contact-form reveal"
                  method="post"
                  asp-controller="Home"
                  asp-action="SendMessage"
                  asp-antiforgery="false"
                  data-contact-form
                  novalidate>
                @Html.AntiForgeryToken()
                <div class="form-field">
                    <label for="name" data-i18n="formName">Name</label>
                    <input id="name" name="Name" type="text" maxlength="200" autocomplete="name" required data-i18n-placeholder="formNamePlaceholder">
                    <small class="field-error" data-error-for="Name"></small>
                </div>
                <div class="form-field">
                    <label for="email" data-i18n="formEmail">Email</label>
                    <input id="email" name="Email" type="email" maxlength="320" autocomplete="email" required data-i18n-placeholder="formEmailPlaceholder">
                    <small class="field-error" data-error-for="Email"></small>
                </div>
                <div class="form-field">
                    <label for="subject" data-i18n="formSubject">Subject</label>
                    <input id="subject" name="Subject" type="text" maxlength="300" required data-i18n-placeholder="formSubjectPlaceholder">
                    <small class="field-error" data-error-for="Subject"></small>
                </div>
                <div class="form-field">
                    <label for="message" data-i18n="formMessage">Message</label>
                    <textarea id="message" name="Message" rows="5" maxlength="4000" required data-i18n-placeholder="formMessagePlaceholder"></textarea>
                    <small class="field-error" data-error-for="Message"></small>
                </div>
                <button class="btn primary form-submit" type="submit" data-i18n="formSubmit">Send Message</button>
                <p class="form-status" data-form-status role="status" aria-live="polite"></p>
            </form>
        </div>
    </section>
</main>
