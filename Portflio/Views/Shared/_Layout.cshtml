@{
    var pageName = ViewData["Page"]?.ToString() ?? "home";
    var pageTitle = ViewData["Title"]?.ToString() ?? "Smart Software Engineering Team";
    var pageDescription = ViewData["Description"]?.ToString()
        ?? "LOGICORE builds smart systems, web applications, mobile apps, and enterprise software solutions.";
}
<!doctype html>
<html lang="en" dir="ltr" data-theme="dark" data-bs-theme="dark" class="dark-theme">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <meta name="description" content="@pageDescription">
    <meta name="keywords" content="LOGICORE, software engineering, web applications, mobile apps, smart systems, enterprise solutions, .NET, Python">
    <meta name="author" content="LOGICORE">
    <meta name="theme-color" content="#040814">
    <meta property="og:title" content="@pageTitle - LOGICORE">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://dummyimage.com/1200x630/0f172a/06b6d4&text=LOGICORE">

    <title>@pageTitle - LOGICORE</title>

    <script>
        (() => {
            const root = document.documentElement;

            // Clear legacy persistent theme so it doesn't force light mode on new visits
            try {
                if (localStorage.getItem("logicore-theme")) {
                    localStorage.removeItem("logicore-theme");
                }
            } catch (e) {}

            // Always default to dark mode when first opening the site
            const savedTheme = sessionStorage.getItem("logicore-theme");
            const initialTheme = savedTheme === "light" ? "light" : "dark";

            const syncTheme = theme => {
                const normalizedTheme = theme === "light" ? "light" : "dark";
                if (root.dataset.theme !== normalizedTheme) {
                    root.dataset.theme = normalizedTheme;
                }
                if (root.dataset.bsTheme !== normalizedTheme) {
                    root.dataset.bsTheme = normalizedTheme;
                }
                root.classList.toggle("dark-theme", normalizedTheme === "dark");
                root.classList.toggle("light-theme", normalizedTheme === "light");

                const metaTheme = document.querySelector('meta[name="theme-color"]');
                if (metaTheme) {
                    metaTheme.content = normalizedTheme === "dark" ? "#040814" : "#F5F0E6";
                }

                const toggle = document.querySelector("[data-theme-toggle]");
                if (toggle) {
                    toggle.setAttribute("aria-pressed", String(normalizedTheme === "light"));
                }
            };

            syncTheme(initialTheme);
            new MutationObserver(() => syncTheme(root.dataset.theme))
                .observe(root, { attributes: true, attributeFilter: ["data-theme"] });
            document.addEventListener("DOMContentLoaded", () => syncTheme(root.dataset.theme));
        })();
    </script>
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/script.js" defer asp-append-version="true"></script>
</head>
<body data-page="@pageName">
    <a class="skip-link" href="#main" data-i18n="skip">Skip to content</a>

    <header class="site-header" id="top">
        <nav class="nav shell" aria-label="Primary navigation" data-i18n-aria="navLabel">
            <a class="brand" asp-controller="Home" asp-action="Index" asp-fragment="home" aria-label="LOGICORE home">
                <img src="~/Logo/logicore-logo.png" alt="LOGICORE Logo" class="brand-logo-img" />
                <span class="brand-text">LOGI<span class="brand-accent">CORE</span></span>
            </a>

            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" data-i18n-aria="menuOpen">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="nav-panel" id="nav-links">
                <a asp-controller="Home" asp-action="Index" asp-fragment="home" data-home-section="home" data-i18n="navHome">Home</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="about" data-home-section="about" data-i18n="navAbout">About</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="services" data-home-section="services" data-i18n="navServices">Services</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="tech" data-home-section="tech" data-i18n="navTech">Tech Stack</a>
                <a asp-controller="Projects" asp-action="Index" data-page-link="projects" data-i18n="navPortfolio">Portfolio</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="team" data-home-section="team" data-i18n="navTeam">Team</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="testimonials" data-home-section="testimonials" data-i18n="navTestimonials">Testimonials</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact" data-home-section="contact" data-i18n="navContact" class="mobile-only-contact">Contact</a>
            </div>

            <div class="utility-controls" aria-label="Site controls" data-i18n-aria="controlsLabel">
                <button class="theme-toggle"
                        type="button"
                        data-theme-toggle
                        data-i18n-aria="themeToggle"
                        aria-pressed="false">
                    <span class="theme-toggle-track" aria-hidden="true">
                        <span class="theme-toggle-icon theme-toggle-sun">☀</span>
                        <span class="theme-toggle-dot"></span>
                        <span class="theme-toggle-icon theme-toggle-moon">☾</span>
                    </span>
                </button>
                <div class="language-switcher" role="group" aria-label="Language" data-i18n-aria="languageLabel">
                    <button type="button" data-lang="en" class="active">EN</button>
                    <button type="button" data-lang="ar">AR</button>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

    <footer class="site-footer">
        <div class="shell footer-grid">
            <div>
                <a class="brand" asp-controller="Home" asp-action="Index" asp-fragment="home" aria-label="LOGICORE home">
                    <img src="~/Logo/logicore-logo.png" alt="LOGICORE Logo" class="brand-logo-img" />
                    <span class="brand-text">LOGI<span class="brand-accent">CORE</span></span>
                </a>
                <p data-i18n="footerTagline">Built with logic &amp; code by LOGICORE.</p>
            </div>
            <div class="footer-links" aria-label="Footer quick links" data-i18n-aria="footerLinksLabel">
                <a asp-controller="Home" asp-action="Index" asp-fragment="about" data-i18n="navAbout">About</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="services" data-i18n="navServices">Services</a>
                <a asp-controller="Projects" asp-action="Index" data-i18n="navPortfolio">Portfolio</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contact" data-i18n="navContact">Contact</a>
            </div>
            <div class="social-links" aria-label="Social media" data-i18n-aria="socialLabel">
                <a href="https://github.com/logicore-dev" target="_blank" rel="noreferrer">GitHub</a>
                <a href="https://linkedin.com/company/logicore-dev" target="_blank" rel="noreferrer">LinkedIn</a>
                <a href="https://x.com/logicoredev" target="_blank" rel="noreferrer">X</a>
                <a href="https://discord.gg/logicore" target="_blank" rel="noreferrer">Discord</a>
            </div>
        </div>
        <div class="shell footer-bottom">
            <p>© <span data-year></span> LOGICORE. <span data-i18n="footerRights">All rights reserved.</span></p>
            <button class="back-to-top" type="button" data-back-to-top data-i18n="backToTop">Back to Top</button>
        </div>
    </footer>

    <!-- Floating WhatsApp Action Button (Bottom-Left) -->
    <a href="https://wa.me/967775458250?text=السَّلَامُ%20عَلَيْكُمْ%20وَرَحْمَةُ%20اللَّهِ%20وَبَرَكَاتُهُ"
       class="floating-whatsapp-btn"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="تواصل معنا عبر واتساب"
       data-i18n-aria="whatsappAria">
        <span class="whatsapp-ping" aria-hidden="true"></span>
        <svg class="whatsapp-icon" viewBox="0 0 448 512" width="30" height="30" fill="currentColor" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
        </svg>
        <span class="whatsapp-tooltip" data-i18n="whatsappTooltip">تواصل عبر واتساب</span>
    </a>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
